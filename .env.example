# Секреты НИКОГДА не коммитятся в репозиторий.
# Скопируй этот файл в .env и заполни нужные значения.
# Приложение читает настройки из data/ (gitignore) или из переменных окружения.

# --- Телеграм (Telethon) для чтения каналов с заказами ---
# Получи api_id/api_hash на https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
# Путь к .env с этими переменными (необязательно — ищется автоматически)
# TG_ENV_FILE=D:/path/to/telegram-mcp/.env

# --- Python с установленным telethon (необязательно) ---
# TG_PYTHON=D:/path/to/telegram-mcp/.venv/Scripts/python.exe

# --- Профиль исполнителя (для hunter init) ---
# FH_PROFILE_NAME=
# FH_PROFILE_TITLE=
# FH_PROFILE_SKILLS=

# --- Хранилище (по умолчанию data/store.db) ---
# FH_DB_FILE=

# --- Ключи ИИ-провайдеров задаются в UI (вкладка «AI-подбор») или в data/ai-providers.json ---
